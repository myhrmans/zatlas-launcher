{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zatlas",
  "identifier": "app.zatlas.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zatlas",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#12140f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "steam_api64.dll": "steam_api64.dll"
    }
  }
}
