{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: events, and opening zatlas.app and Steam pages in the browser",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://zatlas.app/*" }, { "url": "https://steamcommunity.com/*" }]
    }
  ]
}
